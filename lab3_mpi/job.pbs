#!/bin/bash
#PBS -N lab3_mpi
#PBS -l nodes=1:ppn=8
#PBS -l walltime=01:00:00
#PBS -j oe

# Submit from the repository root: qsub -A YOUR_PROJECT lab3_mpi/job.pbs
# Published example uses impi/4. Check actual available modules before submission.
set -eo pipefail
: "${PBS_JOBID:?Submit this script using qsub}"
: "${PBS_O_WORKDIR:?PBS working directory is missing}"
: "${PBS_NODEFILE:?PBS node file is missing}"
: "${PBS_NP:?PBS process allocation is missing}"
[[ "$PBS_NP" =~ ^[1-9][0-9]*$ && "$PBS_NP" -ge 8 ]] || {
    echo 'The full experiment needs at least 8 allocated cores' >&2; exit 1;
}
cd "$PBS_O_WORKDIR"
[[ -f lab3_mpi/main.cpp ]] || { echo 'Submit from the repository root' >&2; exit 1; }
# The environment-module initializer is provided by the cluster, not by this repo.
type module >/dev/null 2>&1 || { echo 'Environment Modules is not initialized' >&2; exit 1; }
if [[ -n "${COMPILER_MODULE:-}" ]]; then module load "$COMPILER_MODULE"; fi
module load "${MPI_MODULE:-impi/4}"
set -u

# Keep each submitted job's binary, temporary matrices, logs and measurements separate.
job_tag="${PBS_JOBID//[^a-zA-Z0-9_.-]/_}"
export RESULT_DIR="$PBS_O_WORKDIR/lab3_mpi/results_korolev/$job_tag"
export RUN_LABEL="korolev-$job_tag"
export MPI_LAUNCHER='bash lab3_mpi/korolev_mpirun.sh'
export OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
export MPLCONFIGDIR="$RESULT_DIR/work/mpl-cache"
mkdir -p "$RESULT_DIR"
{
    date -u
    hostname
    printf 'PBS_JOBID=%s\nPBS_NP=%s\nPBS_NODEFILE=%s\n' "$PBS_JOBID" "$PBS_NP" "$PBS_NODEFILE"
    (set +u; module list) 2>&1
    command -v "${CXX:-g++}" "${MPICXX:-mpicxx}" mpirun "${PYTHON:-python3}"
    "${CXX:-g++}" --version
    "${MPICXX:-mpicxx}" --version
    if command -v lscpu >/dev/null; then lscpu; fi
} > "$RESULT_DIR/cluster_environment.txt" 2>&1
cp "$PBS_NODEFILE" "$RESULT_DIR/pbs_nodefile.txt"
qstat -f "$PBS_JOBID" > "$RESULT_DIR/pbs_job.txt" 2>&1 || true
bash lab3_mpi/run_cluster.sh
